{
  "type": "module",
  "name": "basedserver",
  "version": "1.0.0",
  "description": "A base for my servers.",
  "main": "bin/index.js",
  "scripts": {
    "build": "bunx --bun prisma generate",
    "start": "bun build && bun bin/index.js",
    "dev": "bun src/index.ts",
    "dev:watch": "bun --watch src/index.ts",
    "check": "bun tsc --noEmit",
    "lint": "bun prettier --check ./src && bun eslint ./src --ext .ts",
    "format": "bun prettier --write ./src && bun eslint ./src --ext .ts --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McMistrzYT/BasedServer.git"
  },
  "author": "McMistrzYT",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/McMistrzYT/BasedServer/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/node": "^20.6.3",
    "@types/pg": "^8.16.0",
    "prisma": "^7.4.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "colorette": "^2.0.20",
    "cors": "^2.8.5",
    "erlpack": "^0.1.4",
    "express": "^4.18.2",
    "joi": "^17.13.3",
    "pg": "^8.19.0"
  },
  "homepage": "https://github.com/McMistrzYT/BasedServer#readme",
  "trustedDependencies": [
    "erlpack"
  ]
}
